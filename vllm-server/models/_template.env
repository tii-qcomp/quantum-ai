# ---------------------------------------------------------------------------
# Model profile template. Copy to models/<name>.env, then set MODEL_PROFILE=<name>
# in .env. The file is baked into the image and read by docker/entrypoint.sh;
# every key can be overridden at runtime through overrides.env (compose) or -e.
#
# Format: KEY=value, one per line. Comments only on their own line.
# Empty value = "not set" (vLLM default applies).
# ---------------------------------------------------------------------------

# Hugging Face repo id (or an absolute path inside the container).
MODEL=org/model-name

# Git revision of the repo: branch, tag or commit hash. Pin a hash for
# reproducible images (see the model's "Files and versions" page on the Hub).
MODEL_REVISION=main

# Name exposed through /v1/models and expected in the "model" field of requests.
SERVED_MODEL_NAME=model-name

# Separate tokenizer repo, if different from MODEL. Usually empty.
TOKENIZER=

# Weight / activation dtype: auto, bfloat16, float16, float32.
# "auto" uses the dtype from the model's config.json. float32 is full fp32.
DTYPE=auto

# Context window (prompt + generation). Must not exceed what the model supports.
MAX_MODEL_LEN=

# Max concurrent sequences per scheduler step (vLLM default 256 on recent versions).
MAX_NUM_SEQS=

# Fraction of GPU memory vLLM may claim for weights + KV cache (0.0-1.0).
GPU_MEMORY_UTILIZATION=0.90

# Number of GPUs for tensor parallelism.
TENSOR_PARALLEL_SIZE=1

# 1 = allow the model's custom Python code from the Hub (needed by some architectures).
TRUST_REMOTE_CODE=0

# Chat template for /v1/chat/completions when the tokenizer ships none.
# A bare file name refers to templates/<name> in this repo; absolute paths also work.
CHAT_TEMPLATE=

# Anything else to append to `vllm serve`, e.g. "--enforce-eager --max-num-batched-tokens 8192".
VLLM_EXTRA_ARGS=
