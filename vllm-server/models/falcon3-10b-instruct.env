# ---------------------------------------------------------------------------
# Falcon3-10B-Instruct (TII, Dec 2024). Dense Llama-architecture model, bf16,
# 32k context, Hermes-style tool calling. ~21 GB of weights. Strongest dense
# Falcon3; a conventional-attention alternative to the Falcon-H1 hybrids.
# ---------------------------------------------------------------------------
MODEL=tiiuae/Falcon3-10B-Instruct
MODEL_REVISION=8799bc6aec0152757221dc6b272d824642db6202
SERVED_MODEL_NAME=falcon3-10b-instruct
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=128
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=
VLLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
