# ---------------------------------------------------------------------------
# Falcon-H1R-7B (TII, Jan 2026). Reasoning model on the hybrid Transformer +
# Mamba2 Falcon-H1 architecture (FalconH1ForCausalLM, native in vLLM).
# Native bf16, ~15 GB of weights, up to 256k context, ships its own chat
# template (chat_template.jinja) with <think>...</think> reasoning and
# Hermes-style <tool_call> function calling.
#
# The reasoning parser moves the <think> block into `reasoning_content` of the
# OpenAI response (Open WebUI shows it as a collapsible "Thinking" section).
# Sampling defaults follow the model card: temperature 0.6, top_p 0.95; clients
# can still override them per request.
# ---------------------------------------------------------------------------
MODEL=tiiuae/Falcon-H1R-7B
# Commit of 2026-01-21. Set to "main" to track the latest.
MODEL_REVISION=a6f74bf181389908efd6970878d7ee2b42f5d417
SERVED_MODEL_NAME=falcon-h1r-7b
TOKENIZER=
DTYPE=bfloat16

# Model card: up to 65536 new tokens for reasoning. 131072 leaves room for the
# prompt (web search / documents) on top. The hybrid architecture keeps the
# attention KV cache small (2 KV heads), so this fits easily in 96 GB.
# Native maximum is 262144.
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=64
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=

# No spaces inside the JSON: this value is word-split into separate arguments.
VLLM_EXTRA_ARGS=--reasoning-parser deepseek_r1 --enable-auto-tool-choice --tool-call-parser hermes --override-generation-config {"temperature":0.6,"top_p":0.95}
