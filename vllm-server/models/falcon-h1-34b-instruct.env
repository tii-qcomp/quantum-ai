# ---------------------------------------------------------------------------
# Falcon-H1-34B-Instruct (TII, May 2025). Largest Falcon-H1: hybrid
# Transformer + Mamba2, bf16, native 256k context, Hermes-style tool calling.
# Best Falcon for agentic calibration work (planning experiment sequences,
# interpreting fit results, writing analysis code).
#
# Memory: 67.3 GB of weights leaves ~20 GB of the 96 GB card for KV cache and
# Mamba state, hence the higher utilisation, 32k context and lower concurrency.
# Not suitable for the server-with-weights target on GitHub-hosted runners.
# ---------------------------------------------------------------------------
MODEL=tiiuae/Falcon-H1-34B-Instruct
MODEL_REVISION=6e6890e26cba1f58b1e6ee70d654ddf054f9fce8
SERVED_MODEL_NAME=falcon-h1-34b-instruct
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=16
GPU_MEMORY_UTILIZATION=0.95
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=
VLLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
