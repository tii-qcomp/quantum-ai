# ---------------------------------------------------------------------------
# Deployment settings. Copy to .env and adjust.
# Read by docker compose, scripts/*.sh and the Makefile.
# Keep it simple: KEY=value, comments on their own line, no inline comments.
# Model-specific settings live in models/<MODEL_PROFILE>.env, not here.
# ---------------------------------------------------------------------------

# ---- LLM image ------------------------------------------------------------

# Which model profile to build and run: models/<MODEL_PROFILE>.env
MODEL_PROFILE=falcon-7b-instruct

# Base image. v0.32.0 is the CUDA 13.0 build and includes sm_120 kernels
# (RTX PRO 6000 Blackwell). Append -cu129 for the CUDA 12.9 build.
VLLM_IMAGE=vllm/vllm-openai
VLLM_VERSION=v0.32.0

# Image name. GitHub Actions publishes to this GHCR path; the server pulls it.
# Any local name (e.g. local/vllm-models) works for docker save/load transfer.
IMAGE_NAME=ghcr.io/tii-qcomp/quantum-ai/vllm-models
# Repository URL stamped into the image's OCI source label
IMAGE_SOURCE_URL=https://github.com/tii-qcomp/quantum-ai
# Empty = "<MODEL_PROFILE>-<VLLM_VERSION>". CI tags baked-weights images "<...>-weights".
IMAGE_TAG=

# server              weights downloaded on first start into the hf-cache volume (CI default)
# server-with-weights weights baked into the image for offline hosts (+~14 GB for Falcon-7B)
BUILD_TARGET=server
BUILD_PLATFORM=linux/amd64

# Hugging Face cache for BUILD_TARGET=server images: a named volume or a host path
HF_CACHE_DIR=hf-cache

# ---- Stack ----------------------------------------------------------------

# Optional services, comma-separated. Empty = bare API only.
#   ui          Open WebUI + SearXNG web search
#   monitoring  Prometheus + Grafana
COMPOSE_PROFILES=ui

# Pinned upstream images for the optional services
OPEN_WEBUI_VERSION=v0.12.4
SEARXNG_VERSION=2026.10.25-54ca1d9cf
PROMETHEUS_VERSION=v3.15.1
GRAFANA_VERSION=13.0.11

# ---- Networking -----------------------------------------------------------

# Interface to publish vllm, open-webui and grafana on (searxng and prometheus stay on 127.0.0.1)
BIND_ADDRESS=0.0.0.0
HOST_PORT=8000
WEBUI_HOST_PORT=3000
GRAFANA_HOST_PORT=3001
SEARXNG_HOST_PORT=8081
PROMETHEUS_HOST_PORT=9090

# ---- Secrets --------------------------------------------------------------
# Generate with: openssl rand -hex 32

# SearXNG cookie/CSRF signing key (required by the ui profile)
SEARXNG_SECRET=
# Open WebUI session signing key (keeps logins valid across restarts)
WEBUI_SECRET_KEY=
# Grafana admin password (monitoring profile)
GRAFANA_ADMIN_PASSWORD=admin
# Protect the vLLM API; Open WebUI picks the same key up automatically.
# VLLM_API_KEY=change-me
# Only needed to build images of gated Hugging Face models
# HF_TOKEN=hf_...

# ---- Open WebUI retrieval sizing ------------------------------------------
# Web search / documents inject up to RAG_TOP_K x RAG_CHUNK_SIZE tokens into the
# prompt. Kept small for Falcon-7B's 2048-token window; raise for 32k models.
WEB_SEARCH_RESULT_COUNT=3
RAG_TOP_K=3
RAG_CHUNK_SIZE=400
# For long-context profiles (falcon3-7b-instruct, falcon-h1r-7b) something like:
# WEB_SEARCH_RESULT_COUNT=5
# RAG_TOP_K=8
# RAG_CHUNK_SIZE=1000
