# ---------------------------------------------------------------------------
# Optional runtime overrides, applied on top of the profile baked into the image.
# Copy to overrides.env next to docker-compose.yml on the machine that runs the
# container. Any key from models/_template.env is valid, plus the ones below.
# Only put keys here that you actually want to change.
# ---------------------------------------------------------------------------

# Use less of the GPU, e.g. to leave room for other workloads
# GPU_MEMORY_UTILIZATION=0.50

# Shorter context, more concurrent sequences
# MAX_MODEL_LEN=1024
# MAX_NUM_SEQS=512

# Skip torch.compile / CUDA graphs for a faster (but slower-serving) start
# VLLM_EXTRA_ARGS=--enforce-eager

# Pick the GPU on multi-GPU hosts
# CUDA_VISIBLE_DEVICES=0

# Force offline mode for images built with BUILD_TARGET=server once the cache is warm
# HF_HUB_OFFLINE=1

# Serve a different model with an image built WITHOUT baked weights
# MODEL=tiiuae/Falcon3-7B-Instruct
# MODEL_REVISION=main
# SERVED_MODEL_NAME=falcon3-7b-instruct
# MAX_MODEL_LEN=8192
