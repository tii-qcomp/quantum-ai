# ---------------------------------------------------------------------------
# Falcon-7B base model (TII), not instruction-tuned. Use /v1/completions for
# raw text continuation. /v1/chat/completions works through the simple
# "User:/Assistant:" template in templates/falcon.jinja, but expect base-model
# behaviour (rambling, no instruction following).
# ---------------------------------------------------------------------------
MODEL=tiiuae/falcon-7b
# Commit of 2024-10-12 (adds safetensors). Set to "main" to track the latest.
MODEL_REVISION=ec89142b67d748a1865ea4451372db8313ada0d8
SERVED_MODEL_NAME=falcon-7b
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=256
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=falcon.jinja
VLLM_EXTRA_ARGS=
