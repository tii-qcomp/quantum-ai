# ---------------------------------------------------------------------------
# Falcon-H1-1.5B-Deep-Instruct (TII, May 2025). Small, deep (66-layer) hybrid
# model, bf16, 128k context, Hermes-style tool calling. ~3 GB of weights.
# For high-throughput / low-latency inner loops: classifying fit quality,
# extracting parameters into JSON (use `response_format` / structured outputs),
# routing tool calls between calibration steps.
# ---------------------------------------------------------------------------
MODEL=tiiuae/Falcon-H1-1.5B-Deep-Instruct
MODEL_REVISION=b6648636ddc906688974282de6e7a243395f5423
SERVED_MODEL_NAME=falcon-h1-1.5b-deep-instruct
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=256
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=
VLLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
