# ---------------------------------------------------------------------------
# Falcon-H1-Tiny-R-0.6B (TII, Jan 2026). Tiny reasoning model (<think> traces),
# hybrid Transformer + Mamba2, bf16, 256k context, tool calling. ~1.2 GB.
# Cheap step-by-step checks at very high throughput; also a quick smoke-test
# model for the stack. The model card serves it with the qwen3 reasoning parser.
# ---------------------------------------------------------------------------
MODEL=tiiuae/Falcon-H1-Tiny-R-0.6B
MODEL_REVISION=ccf3d61714e029d86dbd48883f1d40cfc995d433
SERVED_MODEL_NAME=falcon-h1-tiny-r-0.6b
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=256
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=
VLLM_EXTRA_ARGS=--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser hermes
