# ---------------------------------------------------------------------------
# Falcon2-11B-VLM (TII, May 2024). Vision-language model (LLaVA-NeXT on
# Falcon2-11B), bf16, 8k context. ~23 GB of weights. Reads images: calibration
# plots (resonator spectroscopy, Rabi/Ramsey traces, chevrons, IQ blobs),
# instrument screenshots. Send images as OpenAI `image_url` content parts
# (http(s) URL or base64 data URL). No tool calling.
#
# The repo ships no chat template; templates/falcon-vlm.jinja reproduces the
# model card's prompt format "User:<image>\n{instruction} Falcon:".
# ---------------------------------------------------------------------------
MODEL=tiiuae/falcon-11B-vlm
MODEL_REVISION=be99415ebdc1a2fb42bec45feaf03d35aada1359
SERVED_MODEL_NAME=falcon-11b-vlm
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=32
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=falcon-vlm.jinja
VLLM_EXTRA_ARGS=
