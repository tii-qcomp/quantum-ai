# ---------------------------------------------------------------------------
# Falcon-H1-7B-Instruct (TII, May 2025). Hybrid Transformer + Mamba2, bf16,
# native 256k context, Hermes-style tool calling. General-purpose workhorse:
# fast enough for interactive use, long context for instrument logs and
# calibration histories. ~15 GB of weights.
# ---------------------------------------------------------------------------
MODEL=tiiuae/Falcon-H1-7B-Instruct
MODEL_REVISION=41e72f27effbab80cd45b6e884688452253a3686
SERVED_MODEL_NAME=falcon-h1-7b-instruct
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=128
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=
VLLM_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
