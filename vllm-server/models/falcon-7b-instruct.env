# ---------------------------------------------------------------------------
# Falcon-7B-Instruct (TII). Native bf16, 2048-token context, multi-query attention.
# Weights: ~14 GB in bf16, ~28 GB in float32. Both fit easily in 96 GB.
# The tokenizer ships its own chat template, so none is configured here.
# ---------------------------------------------------------------------------
MODEL=tiiuae/falcon-7b-instruct
# Commit of 2024-10-12 (adds safetensors). Set to "main" to track the latest.
MODEL_REVISION=8782b5c5d8c9290412416618f36a133653e85285
SERVED_MODEL_NAME=falcon-7b-instruct
TOKENIZER=

# Full precision without quantization. bfloat16 is the dtype the model was
# trained and released in; use float32 if you really want fp32 compute.
DTYPE=bfloat16

MAX_MODEL_LEN=2048
MAX_NUM_SEQS=256
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
# config.json names the native transformers FalconForCausalLM class; no remote code needed.
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=
VLLM_EXTRA_ARGS=
