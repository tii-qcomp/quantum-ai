# ---------------------------------------------------------------------------
# Falcon3-7B-Instruct (TII, Dec 2024). Llama architecture, 32k-token context,
# native bf16, ships a chat template. ~15 GB of weights.
# Much better fit than Falcon-7B for web search / RAG in Open WebUI because of
# the long context and stronger instruction following.
# ---------------------------------------------------------------------------
MODEL=tiiuae/Falcon3-7B-Instruct
# Commit of 2025-05-31. Set to "main" to track the latest.
MODEL_REVISION=1e57a0ecd176c7c139f289c60a74e57f887c3dfb
SERVED_MODEL_NAME=falcon3-7b-instruct
TOKENIZER=
DTYPE=bfloat16
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=256
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=0
CHAT_TEMPLATE=
VLLM_EXTRA_ARGS=
